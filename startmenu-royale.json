  "webContentCustomJs": "(function () {\n  // XP Royale: keep the two result columns fixed. Hovering a row shows its \"Preview\"\n  // button and the page scrolls horizontally to reveal it, shifting both columns.\n  if (window.__xpRoyaleNoHScroll) return;\n  window.__xpRoyaleNoHScroll = true;\n  document.addEventListener('scroll', function (e) {\n    var t = e.target === document ? document.scrollingElement : e.target;\n    if (t && t.scrollLeft) t.scrollLeft = 0;\n  }, true);\n})();"
}